// ========================================================
// THE CANONICAL PRELUDE LORE ARRAY (With Sans Fleshed Out)
// ========================================================

prelude_text[0]  = "* (This is not the first world you have walked.)";
prelude_text[1]  = "* (When the Dark Fountains broke the earth, the sky went dark.)";
prelude_text[2]  = "* (The Roaring descended... and tore the fabric of your reality to shreds.)";
prelude_text[3]  = "* (From the ash of that collapse, the universe was crudely reconstructed...)";
prelude_text[4]  = "* (...into a subterranean prison of dust and lost souls.)";
prelude_text[5]  = "* (A world called UNDERTALE.)";
prelude_text[6]  = "* (But a fractured soul cannot rest in an incorrect timeline.)";
prelude_text[7]  = "* (To break that underground apart, a terrible price had to be paid.)";
prelude_text[8]  = "* (Chara... Kris... you slaughtered the monsters you once called family.)";
prelude_text[9]  = "* (You harvested their dust. You forced your execution power to its absolute peak.)";
prelude_text[10] = "* (Not out of hatred... but for the raw power needed to tear a universe asunder.)";
prelude_text[11] = "* (You shattered that world... and reconstructed it back into DELTARUNE.)";

// REFINED SANS LORE COMPARTMENT (Forgetting is the Easy Option)
prelude_text[12] = "* (But you are not the only one fighting to keep the past alive.)";
prelude_text[13] = "* (Standing outside his grocery shop... a smiling skeleton watches the sky.)";
prelude_text[14] = "* (Forgetting would be the easy choice.)";
prelude_text[15] = "* (To let the reset wash his mind clean would mean peace... an end to the depression.)";
prelude_text[16] = "* (Without the memories of your knife, he could just be a normal guy.)";
prelude_text[17] = "* (But he refuses to let the dust fade into oblivion.)";
prelude_text[18] = "* (With exhausting, agonizing focus, he forces himself to remember the world you slaughtered...)";
prelude_text[19] = "* (In hopes that someone would eventually stop this hellish loop... )";
prelude_text[20] = "* (...carrying a heavy apathy that lines his smile with permanent insomnia.)";


// CONTINUATION OF THE SYSTEM CODES:
prelude_text[21] = "* (The correction failed. You are trapped in a repeating spiral.)";
prelude_text[22] = "* (Each reset wipes the mind clean... unless your determination burns absolute.)";
prelude_text[23] = "* (You must hold an unwavering focus within your SOUL to carry memories across the seam.)";
prelude_text[24] = "* (Hold fast to your thoughts, killer...)";
prelude_text[25] = "* (...the beginning and the end are collapsing together once more.)";

